[gd_resource type="Resource" script_class="Campaign" format=3]

[ext_resource type="Script" path="res://scripts/campaign/campaign.gd" id="1_campaign"]
[ext_resource type="Script" path="res://scripts/campaign/chapter_data.gd" id="2_chapter"]
[ext_resource type="Script" path="res://scripts/model/level_data.gd" id="3_level"]
[ext_resource type="Resource" path="res://data/levels/m01.tres" id="4_m01"]
[ext_resource type="Resource" path="res://data/levels/m02.tres" id="5_m02"]
[ext_resource type="Resource" path="res://data/levels/m03.tres" id="6_m03"]
[ext_resource type="Resource" path="res://data/levels/m04.tres" id="7_m04"]
[ext_resource type="Resource" path="res://data/levels/m05.tres" id="8_m05"]
[ext_resource type="Resource" path="res://data/levels/m06.tres" id="9_m06"]
[ext_resource type="Resource" path="res://data/levels/m07.tres" id="10_m07"]
[ext_resource type="Resource" path="res://data/levels/m08.tres" id="11_m08"]
[ext_resource type="Resource" path="res://data/levels/m09.tres" id="12_m09"]
[ext_resource type="Resource" path="res://data/levels/m10.tres" id="13_m10"]
[ext_resource type="Resource" path="res://data/levels/m11.tres" id="14_m11"]
[ext_resource type="Resource" path="res://data/levels/m12.tres" id="15_m12"]
[ext_resource type="Resource" path="res://data/levels/m13.tres" id="16_m13"]
[ext_resource type="Resource" path="res://data/levels/m14.tres" id="17_m14"]

[sub_resource type="Resource" id="Chapter_1"]
script = ExtResource("2_chapter")
chapter_id = 1
title = "First Signals"
subtitle = "A dormant network wakes. Untangle its first connections."
missions = Array[ExtResource("3_level")]([ExtResource("4_m01"), ExtResource("5_m02"), ExtResource("6_m03"), ExtResource("7_m04"), ExtResource("8_m05")])

[sub_resource type="Resource" id="Chapter_2"]
script = ExtResource("2_chapter")
chapter_id = 2
title = "Shaped Minds"
subtitle = "Thought bends to the shape of its vessel. Walls and hollows guide every move."
missions = Array[ExtResource("3_level")]([ExtResource("9_m06"), ExtResource("10_m07"), ExtResource("11_m08"), ExtResource("12_m09"), ExtResource("13_m10")])

[sub_resource type="Resource" id="Chapter_3"]
script = ExtResource("2_chapter")
chapter_id = 3
title = "Anchored"
subtitle = "Some memories will not move. Build the network around the red anchors."
missions = Array[ExtResource("3_level")]([ExtResource("14_m11"), ExtResource("15_m12"), ExtResource("16_m13"), ExtResource("17_m14")])

[resource]
script = ExtResource("1_campaign")
chapters = Array[ExtResource("2_chapter")]([SubResource("Chapter_1"), SubResource("Chapter_2"), SubResource("Chapter_3")])
