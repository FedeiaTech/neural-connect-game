[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/screens/settings_screen.gd" id="1_settings"]
[ext_resource type="PackedScene" path="res://scenes/views/background.tscn" id="2_background"]
[ext_resource type="Script" path="res://scripts/ui/glow_title.gd" id="3_title"]
[ext_resource type="Script" path="res://scripts/ui/glow_button.gd" id="4_button"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Background" parent="." instance=ExtResource("2_background")]

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Center/Panel"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
theme_override_constants/separation = 36

[node name="Title" type="Control" parent="Center/Panel/Column"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_title")
text = "Settings"
font_size = 64

[node name="VolumeRow" type="HBoxContainer" parent="Center/Panel/Column"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="VolumeLabel" type="Label" parent="Center/Panel/Column/VolumeRow"]
layout_mode = 2
text = "Master volume"

[node name="VolumeSlider" type="HSlider" parent="Center/Panel/Column/VolumeRow"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 1.0

[node name="VolumeValue" type="Label" parent="Center/Panel/Column/VolumeRow"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "100%"
horizontal_alignment = 2

[node name="ReducedMotionToggle" type="CheckButton" parent="Center/Panel/Column"]
layout_mode = 2
text = "Reduced motion"

[node name="ResetBox" type="VBoxContainer" parent="Center/Panel/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ResetButton" type="Button" parent="Center/Panel/Column/ResetBox"]
custom_minimum_size = Vector2(320, 56)
layout_mode = 2
size_flags_horizontal = 4
text = "Reset progress"
script = ExtResource("4_button")

[node name="ConfirmRow" type="HBoxContainer" parent="Center/Panel/Column/ResetBox"]
visible = false
layout_mode = 2
alignment = 1
theme_override_constants/separation = 20

[node name="ConfirmLabel" type="Label" parent="Center/Panel/Column/ResetBox/ConfirmRow"]
layout_mode = 2
text = "Erase all mission progress?"

[node name="ConfirmButton" type="Button" parent="Center/Panel/Column/ResetBox/ConfirmRow"]
custom_minimum_size = Vector2(160, 56)
layout_mode = 2
text = "Reset"
script = ExtResource("4_button")

[node name="CancelButton" type="Button" parent="Center/Panel/Column/ResetBox/ConfirmRow"]
custom_minimum_size = Vector2(160, 56)
layout_mode = 2
text = "Cancel"
script = ExtResource("4_button")

[node name="FeedbackLabel" type="Label" parent="Center/Panel/Column/ResetBox"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.91, 1, 0.75)
text = "Progress reset"
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Center/Panel/Column"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"
script = ExtResource("4_button")
