[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/star_row.gd" id="2_stars"]
[ext_resource type="Script" path="res://scripts/ui/glow_button.gd" id="3_button"]
[ext_resource type="Script" path="res://scripts/ui/glow_title.gd" id="4_title"]
[ext_resource type="Shader" path="res://assets/shaders/light_sweep.gdshader" id="5_sweep"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sweep"]
shader = ExtResource("5_sweep")
shader_parameter/progress = -1.0

[node name="HUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="TopBar" type="MarginContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 80.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 12

[node name="Row" type="HBoxContainer" parent="TopBar"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 40

[node name="MissionLabel" type="Label" parent="TopBar/Row"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.96, 1, 1)
theme_override_colors/font_outline_color = Color(0.45, 0.72, 1, 0.16)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 28

[node name="Spacer" type="Control" parent="TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="MovesLabel" type="Label" parent="TopBar/Row"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.96, 1, 0.9)
theme_override_colors/font_outline_color = Color(0.45, 0.72, 1, 0.16)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 28

[node name="TimeLabel" type="Label" parent="TopBar/Row"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.96, 1, 0.9)
theme_override_colors/font_outline_color = Color(0.45, 0.72, 1, 0.16)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 28
text = "00:00"

[node name="RestartButton" type="Button" parent="TopBar/Row"]
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "HUD_RESTART"
script = ExtResource("3_button")

[node name="PauseButton" type="Button" parent="TopBar/Row"]
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "HUD_PAUSE"
script = ExtResource("3_button")

